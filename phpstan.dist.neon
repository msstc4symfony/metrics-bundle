parameters:
    level: 9
    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
    treatPhpDocTypesAsCertain: false
    phpVersion: 80400
    parallel:
        jobSize: 5
        maximumNumberOfProcesses: 12
        minimumNumberOfJobsPerProcess: 2
    paths:
        - src/
        - tests/unit/
        - tests/integration/
    excludePaths:
        - src/Framework/Profiling/Processor/EndSpan/MetricProcessor.php

includes:
    - phpstan-baseline.neon
