parameters:
	ignoreErrors:
		-
			message: '#^Class Doctrine\\DBAL\\Connection not found\.$#'
			identifier: class.notFound
			count: 1
			path: src/DependencyInjection/Compiler/AddDoctrineDBALMonitorPass.php

		-
			message: '#^Class Symfony\\Component\\HttpClient\\ScopingHttpClient not found\.$#'
			identifier: class.notFound
			count: 2
			path: src/DependencyInjection/Compiler/AddHttpClientMonitorPass.php

		-
			message: '#^Class Elastica\\Client not found\.$#'
			identifier: class.notFound
			count: 1
			path: src/DependencyInjection/Compiler/SaveElasticaClientsListPass.php

		-
			message: '#^Offset 0 on array\{float, float, float\} in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 1
			path: src/Framework/EventListener/InfoEventListener.php

		-
			message: '#^Parameter \#2 \$name of method Prometheus\\RegistryInterface\:\:getOrRegisterCounter\(\) expects string, int\|string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Infrastructure/Collector/AbstractCollector.php

		-
			message: '#^Parameter \#2 \$name of method Prometheus\\RegistryInterface\:\:getOrRegisterGauge\(\) expects string, int\|string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Infrastructure/Collector/AbstractCollector.php

		-
			message: '#^Parameter \#2 \$name of method Prometheus\\RegistryInterface\:\:getOrRegisterHistogram\(\) expects string, int\|string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Infrastructure/Collector/AbstractCollector.php

		-
			message: '#^Parameter \#2 \$name of method Prometheus\\RegistryInterface\:\:getOrRegisterSummary\(\) expects string, int\|string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Infrastructure/Collector/AbstractCollector.php

		-
			message: '#^Class Symfony\\Component\\Security\\Core\\Exception\\AccessDeniedException not found\.$#'
			identifier: class.notFound
			count: 1
			path: src/Infrastructure/Collector/ErrorCollector.php

		-
			message: '#^Call to function method_exists\(\) with MongoDB\\Driver\\Monitoring\\CommandFailedEvent and ''getHost'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Infrastructure/Doctrine/ODM/Metrics/TimingSubscriber.php

		-
			message: '#^Call to function method_exists\(\) with MongoDB\\Driver\\Monitoring\\CommandSucceededEvent and ''getHost'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Infrastructure/Doctrine/ODM/Metrics/TimingSubscriber.php

		-
			message: '#^Parameter \#1 \$level of static method Monolog\\Logger\:\:toMonologLevel\(\) expects 100\|200\|250\|300\|400\|500\|550\|600\|''ALERT''\|''alert''\|''CRITICAL''\|''critical''\|''DEBUG''\|''debug''\|''EMERGENCY''\|''emergency''\|''ERROR''\|''error''\|''INFO''\|''info''\|''NOTICE''\|''notice''\|''WARNING''\|''warning''\|Monolog\\Level, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Infrastructure/Monolog/Handler/HandlerDecorator.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(array\<mixed\>\|string\)\: mixed\)\|null, Closure\(bool\|float\|int\|resource\|string\|null\)\: string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Infrastructure/Storage/Factory.php

		-
			message: '#^Call to method getConnections\(\) on an unknown class Elastica\\Client\.$#'
			identifier: class.notFound
			count: 1
			path: src/MetricsBundle.php

		-
			message: '#^Call to method getTransportObject\(\) on an unknown class Elastica\\Connection\.$#'
			identifier: class.notFound
			count: 1
			path: src/MetricsBundle.php

		-
			message: '#^Call to method setTransport\(\) on an unknown class Elastica\\Connection\.$#'
			identifier: class.notFound
			count: 1
			path: src/MetricsBundle.php

		-
			message: '#^Class Elastica\\Client not found\.$#'
			identifier: class.notFound
			count: 1
			path: src/MetricsBundle.php

		-
			message: '#^PHPDoc tag @var for variable \$connection contains unknown class Elastica\\Connection\.$#'
			identifier: class.notFound
			count: 1
			path: src/MetricsBundle.php
